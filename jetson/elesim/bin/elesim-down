#!/usr/bin/env bash
set -euo pipefail
umask 077
if (( $# != 0 )); then
  printf '사용법: elesim-down\n' >&2
  exit 64
fi
archive_path_has_no_symlink_ancestor() {
  local target=$1
  local probe=$target
  local resolved
  while [[ ! -e "$probe" && ! -L "$probe" ]]; do
    [[ $probe == / ]] && break
    probe=${probe%/*}
    [[ -n $probe ]] || probe=/
  done
  [[ ! -L "$probe" ]] || return 1
  resolved="$(realpath -e -- "$probe")" || return 1
  [[ $resolved == "$probe" ]]
}
archive_runtime_logs() {
  local logs_root=/home/idim/elesim/logs
  local runs_root="$logs_root/runs"
  if ! archive_path_has_no_symlink_ancestor "$logs_root"; then
    printf '로그 archive 경로에 symlink가 포함될 수 없습니다: %s\n' "$logs_root" >&2
    return 74
  fi
  if ! mkdir -p -- "$runs_root" || ! archive_path_has_no_symlink_ancestor "$logs_root" || ! archive_path_has_no_symlink_ancestor "$runs_root" || [[ ! -d "$logs_root" || ! -d "$runs_root" ]]; then
    printf '로그 archive 디렉터리를 안전하게 만들 수 없습니다: %s\n' "$runs_root" >&2
    return 74
  fi
  if ! chmod 0700 -- "$logs_root" "$runs_root"; then
    printf '로그 archive 디렉터리 권한 설정 실패: %s\n' "$runs_root" >&2
    return 74
  fi
  local timestamp
  if ! timestamp="$(date -u +%Y%m%dT%H%M%S.%NZ)"; then
    printf 'UTC 로그 archive timestamp 생성 실패.\n' >&2
    return 74
  fi
  local run_dir="$runs_root/$timestamp"
  if [[ -e "$run_dir" || -L "$run_dir" ]] || ! mkdir -- "$run_dir"; then
    printf '고유 로그 archive 디렉터리 생성 실패: %s\n' "$run_dir" >&2
    return 74
  fi
  chmod 0700 -- "$run_dir" || return 74
  local destination="$run_dir/robot.log"
  local archive_status=0
  if ! sudo -n journalctl --no-pager --output=short-iso-precise --unit=elesim-robot.service --unit=elesim-unitree-bridge.service 2>&1 | tail -c 10485760 >"$destination"; then
    printf 'Robot journald 로그 저장 실패: %s\n' "$destination" >&2
    archive_status=74
  fi
  chmod 0600 -- "$destination" || archive_status=74
  local -a generations=()
  local candidate name
  shopt -s nullglob
  for candidate in "$runs_root"/*; do
    [[ -d "$candidate" && ! -L "$candidate" ]] || continue
    name="${candidate##*/}"
    [[ $name =~ ^[0-9]{8}T[0-9]{6}\.[0-9]{9}Z$ ]] || continue
    generations+=("$candidate")
  done
  if (( ${#generations[@]} > 5 )); then
    mapfile -t generations < <(printf '%s\n' "${generations[@]}" | LC_ALL=C sort)
    local remove_count=$((${#generations[@]} - 5))
    local index
    for ((index = 0; index < remove_count; index++)); do
      candidate="${generations[index]}"
      if [[ -L "$candidate" || ! -d "$candidate" || "$candidate" != "$runs_root/"* ]]; then
        printf '안전하지 않은 archive 삭제 대상을 건너뜁니다: %s\n' "$candidate" >&2
        archive_status=74
        continue
      fi
      rm -rf -- "$candidate" || archive_status=74
    done
  fi
  printf '로그 archive: %s\n' "$run_dir"
  return "$archive_status"
}
archive_status=0
archive_runtime_logs || archive_status=$?
stop_status=0
sudo -n systemctl stop elesim-robot.service || stop_status=$?
if (( stop_status != 0 )); then
  exit "$stop_status"
fi
exit "$archive_status"
