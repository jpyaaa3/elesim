# syntax=docker/dockerfile:1
FROM ros:humble-ros-base-jammy AS see_builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake libpcl-dev libnlopt-cxx-dev liblemon-dev && \
    rm -rf /var/lib/apt/lists/*
COPY wheels/ /tmp/wheels/
ARG APP_WHEEL
RUN python3 -m zipfile -e "/tmp/wheels/${APP_WHEEL}" /tmp/see-wheel && \
    cmake -S /tmp/see-wheel/elesim_pilot/vision/see_native -B /tmp/see-build \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/see-build -j2

FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    AMENT_PREFIX_PATH=/opt/elesim/ros/install \
    CMAKE_PREFIX_PATH=/opt/elesim/ros/install \
    PYTHONPATH=/opt/elesim/ros/install/local/lib/python3.10/dist-packages \
    LD_LIBRARY_PATH=/opt/elesim/ros/install/lib

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      nodejs \
      libpcl-common1.12 libpcl-octree1.12 libnlopt0 liblemon1.3.1 \
      libgl1 \
      libegl1 \
      libusb-1.0-0 \
      libglib2.0-0 \
      libgomp1 \
      python3-colcon-common-extensions \
      python3-pip \
      ros-humble-rmw-cyclonedds-cpp \
      ros-humble-rosidl-default-generators \
      ros-humble-sros2 && \
    rm -rf /var/lib/apt/lists/*

COPY interfaces/elesim_interfaces/ /tmp/ros_ws/src/elesim_interfaces/
RUN . /opt/ros/humble/setup.sh && \
    colcon --log-base /tmp/ros_ws/log build \
      --base-paths /tmp/ros_ws/src/elesim_interfaces \
      --build-base /tmp/ros_ws/build \
      --install-base /opt/elesim/ros/install && \
    rm -rf /tmp/ros_ws/build /tmp/ros_ws/log

COPY requirements.lock /opt/elesim/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python3 -m pip install -r /opt/elesim/requirements.lock
RUN python3 -c 'import open3d; print("Open3D meshing import:", open3d.__version__)'

COPY wheels/ /tmp/wheels/
ARG PROTOCOL_WHEEL
ARG APP_WHEEL
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python3 -m pip install --no-deps \
      "/tmp/wheels/${PROTOCOL_WHEEL}" \
      "/tmp/wheels/${APP_WHEEL}" && \
    python3 -m pip check && \
    rm -rf /tmp/wheels

# No compiler, ROS 1, or PCL visualization dependencies in the final role image.
COPY --from=see_builder /tmp/see-build/libelesim_see.so /opt/elesim/native/libelesim_see.so
RUN python3 -c 'import ctypes; ctypes.CDLL("/opt/elesim/native/libelesim_see.so")'

COPY config/ /opt/elesim/config/
COPY data/ /opt/elesim/data/

WORKDIR /opt/elesim
ENTRYPOINT ["/ros_entrypoint.sh", "elesim-pilot", "--config", "/opt/elesim/config/config.yaml", "--runtime-config", "/opt/elesim/config/runtime.yaml"]
