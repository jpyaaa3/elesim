# EleSim mock object, metres.  Deliberately simple and bounded.
v -0.060 -0.040 -0.080
v  0.060 -0.040 -0.080
v  0.060  0.040 -0.080
v -0.060  0.040 -0.080
v -0.060 -0.040  0.080
v  0.060 -0.040  0.080
v  0.060  0.040  0.080
v -0.060  0.040  0.080
# Counter-clockwise when viewed from outside. Genesis' rasterizer culls the
# back side, so inward winding makes an otherwise closed box look inside-out.
f 4 3 2 1
f 6 7 8 5
f 2 6 5 1
f 3 7 6 2
f 4 8 7 3
f 8 4 1 5
